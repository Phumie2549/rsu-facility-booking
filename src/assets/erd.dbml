// ระบบขอใช้สถานที่ภายในมหาวิทยาลัยรังสิต (RSU Facility Booking System)
Project RSU_Facility_Booking {
  database_type: 'PostgreSQL'
  Note: 'ฐานข้อมูลระบบขอใช้สถานที่ มหาวิทยาลัยรังสิต เชื่อมต่อกับ Supabase Auth'
}

// 1. ตารางจำลองระบบ Authentication ของ Supabase
Table auth.users {
  id uuid [pk, note: 'รหัสอ้างอิงผู้ใช้จาก Supabase Auth']
  email varchar [unique, not null, note: 'รูปแบบ {student_id}@rsu.local']
  created_at timestamptz
}

// 2. ตารางข้อมูลโปรไฟล์ผู้ใช้งาน (นักศึกษา / เจ้าหน้าที่)
Table profiles {
  id uuid [pk, ref: - auth.users.id, note: 'เชื่อม 1:1 กับ auth.users']
  student_id text [unique, not null, note: 'รหัสนักศึกษา หรือ รหัสบุคลากร']
  full_name text [not null, note: 'ชื่อ - นามสกุล']
  faculty text [not null, note: 'คณะ / วิทยาลัย / หน่วยงาน']
  phone text [note: 'เบอร์โทรศัพท์ติดต่อ']
  role text [default: 'student', note: 'บทบาท: student | admin']
  created_at timestamptz [default: `now()`]
}

// 3. ตารางสถานที่ภายในมหาวิทยาลัยรังสิต
Table facilities {
  id int [pk, increment, note: 'รหัสสถานที่']
  name text [not null, note: 'ชื่อห้อง / หอประชุม / ลานกิจกรรม']
  building text [not null, note: 'อาคาร / ตึกที่ตั้ง']
  category text [not null, note: 'ประเภทสถานที่']
  capacity int [not null, note: 'จำนวนความจุสูงสุด (คน)']
  equipment text[] [note: 'รายการอุปกรณ์โสตทัศนูปกรณ์']
  image_url text [note: 'ลิงก์รูปภาพสถานที่']
  is_active boolean [default: true, note: 'สถานะเปิดให้จอง']
}

// 4. ตารางคำร้องขอใช้สถานที่
Table bookings {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสคำร้องขอใช้สถานที่']
  user_id uuid [not null, ref: > profiles.id, note: 'ผู้ยื่นคำร้อง']
  facility_id int [not null, ref: > facilities.id, note: 'สถานที่ที่ขอใช้']
  event_title text [not null, note: 'ชื่อโครงการ / กิจกรรม']
  organizer text [not null, note: 'หน่วยงาน / คณะผู้จัด']
  booking_date date [not null, note: 'วันที่ขอใช้สถานที่']
  start_time time [not null, note: 'เวลาเริ่มต้น']
  end_time time [not null, note: 'เวลาสิ้นสุด']
  attendees int [not null, note: 'จำนวนผู้เข้าร่วม (คน)']
  purpose text [note: 'รายละเอียดกิจกรรม / อุปกรณ์เพิ่มเติม']
  status text [default: 'pending', note: 'สถานะ: pending | approved | rejected']
  admin_note text [note: 'หมายเหตุผลการพิจารณาจากเจ้าหน้าที่']
  created_at timestamptz [default: `now()`]
}
